# Copy this file to .env and fill in your values.
# .env is git-ignored and read by build.rs (device) or at runtime (simulator).

MARATUI_WIFI_SSID=YourWifiSSID
MARATUI_WIFI_PASSWORD=YourWifiPassword

MARATUI_MQTT_ENABLED=true
MARATUI_MQTT_URL=mqtt://192.168.1.x:1883
MARATUI_MQTT_CLIENT_ID=maratui
MARATUI_MQTT_USERNAME=
MARATUI_MQTT_PASSWORD=
MARATUI_MQTT_TOPIC_PREFIX=mara
